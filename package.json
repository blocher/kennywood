{
  "name": "kennywood-waits",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name=kennywood-waits"
  },
  "devDependencies": {
    "typescript": "~5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.120.0"
  }
}
